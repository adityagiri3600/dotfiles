[global]
font = Hack 11

# Layout
width = 360
height = 120
origin = top-right
offset = 12x36
notification_limit = 5

# Spacing
padding = 14
horizontal_padding = 16
text_icon_padding = 12
separator_height = 2

# Rounded border
corner_radius = 5
frame_width = 1
frame_color = "#ffba5f"

# Colors
separator_color = frame
background = "#1e1e2e"
foreground = "#cdd6f4"

# Text
markup = full
format = "󰎟 <b>%s</b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = 60
word_wrap = yes
ellipsize = middle

# Icons
icon_position = left
min_icon_size = 32
max_icon_size = 48

# Behavior
sort = yes
idle_threshold = 120
default_icon = dialog-information

[urgency_low]
background = "#181825"
foreground = "#cdd6f4"
frame_color = "#45475a"
timeout = 3

[urgency_normal]
background = "#1e1e2e59"
foreground = "#cdd6f4"
# frame_color = "#89b4fa"
timeout = 5

[urgency_critical]
background = "#f38ba8"
foreground = "#11111b"
frame_color = "#f38ba8"
timeout = 0