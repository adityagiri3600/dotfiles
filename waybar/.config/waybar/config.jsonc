{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "passthrough": false,
  "fixed-center": true,

  "margin-top": 2,
  "margin-left": 2,
  "margin-right": 2,
  "margin-bottom": 0,
  "height": 24,

  "modules-left": [
    "hyprland/workspaces",
    "custom/screenrecording-indicator",
    "custom/updatespacman",
    "custom/update",
    "hyprland/window"
  ],

  "modules-center": [
    "custom/clock-jp"
  ],

  "modules-right": [
    "tray",
    "cpu",
    "bluetooth",
    "pulseaudio",
    "network",
    "custom/battery"
  ],

  "hyprland/workspaces": {
    "on-click": "activate",
    "disable-scroll": true,
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "1": "<span size='large'>一</span>",
      "2": "<span size='large'>二</span>",
      "3": "<span size='large'>三</span>",
      "4": "<span size='large'>四</span>",
      "5": "<span size='large'>五</span>",
      "6": "<span size='large'>六</span>",
      "7": "<span size='large'>七</span>",
      "8": "<span size='large'>八</span>"
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "custom/update": {
    "format": "",
    "exec": "/home/aditya/.local/bin/omarchy-update-available",
    "on-click": "/home/aditya/.local/bin/omarchy-launch-floating-terminal-with-presentation omarchy-update",
    "tooltip-format": "Omarchy update available",
    "signal": 7,
    "interval": 21600
  },

  "custom/updatespacman": {
    "format": "{}{icon}",
    "return-type": "json",
    "format-icons": {
      "has-updates": " 󰏖",
      "updated": ""
    },
    "exec-if": "test -x /home/aditya/.local/bin/waybar-module-pacman-updates",
    "exec": "/home/aditya/.local/bin/waybar-module-pacman-updates --no-zero-output"
  },

  "hyprland/window": {
    "format": "{title} - {class}",
    "max-length": 100,
    "icon": true,
    "rewrite": {
      "(.*?) .*Zen.*":  "$1 ",
    }
  },

  "custom/clock-jp": {
    "exec": "bash /home/aditya/.config/waybar/clock-jp.sh",
    "interval": 60,
    "return-type": "json",
    "tooltip": true,
    "on-click-right": "/home/aditya/.local/bin/omarchy-launch-floating-terminal-with-presentation omarchy-tz-select"
  },

  "cpu": {
    "interval": 2,
    "format": "{usage}% 󰍛",
    "on-click": "/home/aditya/.local/bin/omarchy-launch-or-focus-tui btop"
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}   {essid} {bandwidthDownBytes}↓ {bandwidthUpBytes}↑",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "/home/aditya/.local/bin/omarchy-launch-wifi"
  },

  "custom/battery": {
    "exec": "bash /home/aditya/.config/waybar/battery.sh",
    "interval": 5,
    "return-type": "json",
    "tooltip": true,
    "on-click": "/home/aditya/.local/bin/omarchy-menu power"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "omarchy-launch-bluetooth"
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headset": "",
      "default": ["", "", " "]
    }
  },

  "custom/idle-indicator": {
    "on-click": "omarchy-toggle-idle",
    "exec": "/home/aditya/.config/omarchy/default/waybar/indicators/idle.sh",
    "signal": 9,
    "return-type": "json"
  },
  "custom/notification-silencing-indicator": {
    "on-click": "omarchy-toggle-notification-silencing",
    "exec": "/home/aditya/.config/omarchy/default/waybar/indicators/notification-silencing.sh",
    "signal": 10,
    "return-type": "json"
  },
  "tray": {
    "icon-size": 12,
    "spacing": 10
  },

  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "interval": 1800,
    "exec": "/home/aditya/.config/omarchy/default/waybar/weather.sh",
    "return-type": "json"
  },

  "custom/screenrecording-indicator": {
    "on-click": "/home/aditya/.local/bin/omarchy-capture-screenrecording",
    "exec": "/home/aditya/.config/omarchy/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json"
  }
}
